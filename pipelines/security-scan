pipeline {
  agent any

  parameters {
    string(name: 'TARGET_URL', defaultValue: 'https://emadmukhtar.com', description: 'The website URL to scan')
    string(name: 'REPORT_NAME', defaultValue: 'zap_report.html', description: 'Name of the HTML report to generate')
  }

  stages {
    stage('Pull Scan Image'){
      steps {
        script{
          sh 'docker pull zaproxy/zap-stable:latest'
        }
      }
    }

    stage('Security Scan') {
      steps {
        script {

          // Delete existing ZAP container if any
          sh 'docker stop zaproxy || true'
          sh 'docker rm zaproxy || true'

          // Run baseline scan
          sh """
            docker run -u 1000:1000 \
              -v ${env.WORKSPACE}:/zap/wrk/:rw \
              --name zaproxy zaproxy/zap-stable \
              zap-baseline.py -t ${params.TARGET_URL} -r ${params.REPORT_NAME} || true
          """
        }
      }
    }

    stage('Archive Report') {
      steps {
        archiveArtifacts artifacts: "${params.REPORT_NAME}", allowEmptyArchive: true
      }
    }
  }
}
